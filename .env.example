# Node.js 24+, PostgreSQL 17
PORT=3001
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://shamsaz:replace-with-a-long-random-password@127.0.0.1:5433/shamsaz

# Explicit opt-in synthetic development data; forbidden in production.
ENABLE_DEMO_SEED=false
DEMO_PASSWORD=

# Set to the exact public HTTPS origin for production.
# APP_ORIGIN=https://your-domain.example
# Render supplies RENDER_EXTERNAL_URL automatically; APP_ORIGIN overrides it for a custom domain.
# Recovery: configure SMTP for email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Local-only recovery preview; never enabled in production.
ENABLE_DEV_AUTH_INBOX=false
# AI optional; no key means unavailable, not a simulated clinical answer.
GEMINI_API_KEY=
