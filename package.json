{
  "name": "shamsaz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=shared --watch-path=server.ts server.ts",
    "start": "node scripts/start-production.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node server/db/migrate.ts",
    "directory:import": "node scripts/import-practitioners.ts",
    "directory:snapshot": "node scripts/public-directory-snapshot.ts export",
    "directory:restore": "node scripts/public-directory-snapshot.ts restore",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.ts",
    "test": "node scripts/test.mjs",
    "test:ui": "node scripts/ui-auth.mjs",
    "db:up": "docker compose up -d postgres",
    "db:status": "docker compose ps postgres",
    "test:directory": "node scripts/ui-directory.mjs",
    "test:booking": "node scripts/ui-booking.mjs",
    "test:banners": "node scripts/ui-banners.mjs",
    "test:carousel": "node scripts/ui-home-carousel.mjs",
    "test:centers": "node scripts/ui-centers.mjs",
    "test:patient-doctor": "node scripts/ui-patient-doctor-flow.mjs",
    "test:screening": "node scripts/ui-screening.mjs",
    "test:production": "node scripts/test-production.mjs",
    "deploy:package": "node scripts/package-deployment.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
